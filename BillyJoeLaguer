<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Billy Joe Portfolio</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- CSS -->
    <link rel="stylesheet" href="style.css">
</head>

<body>

<!-- NAVIGATION -->
<nav class="navbar navbar-expand-lg navbar-light bg-white">
    <div class="container">

        <a class="navbar-brand fw-bold" href="#home">
            BJ.
        </a>

        <button class="navbar-toggler"
                data-bs-toggle="collapse"
                data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse"
             id="navbarNav">

            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="#home">Home</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#about">About Me</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#achievements">Achievements</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#contact">Contact</a>
                </li>
            </ul>

        </div>
    </div>
</nav>

<!-- HOME -->
<section id="home" class="container py-5">
    <div class="row align-items-center">

        <div class="col-md-5 text-center">
            <img src="images/profile.jpg"
                 class="img-fluid profile"
                 alt="My Picture">
        </div>

        <div class="col-md-7">
            <h1>Hi, I'm Billy Joe Laguer</h1>

            <p>
                Welcome to my portfolio!
                Here you can learn more about me
                and my achievements.
            </p>

            <a href="#about" class="btn btn-dark">
                Learn More
            </a>
        </div>

    </div>
</section>

<!-- ABOUT ME -->
<section id="about" class="container py-5">

    <h2 class="text-center mb-4">About Me</h2>

    <div class="row align-items-center">

        <div class="col-md-5">
            <img src="images/about.jpg"
                 class="img-fluid rounded"
                 alt="About Me">
        </div>

        <div class="col-md-7">
            <h3>Hello Again!</h3>

            <p>
                Thanks for scrolling this far!
                I live in Aningway, Iba, Zambales.

                I have already finished a course
                in Electrical Technology, and I am
                currently studying for an Associate
                in Computer Technology.
            </p>
        </div>

    </div>
</section>

<!-- ACHIEVEMENTS -->
<section id="achievements" class="container py-5">

    <h2 class="text-center mb-4">
        My Achievements
    </h2>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card shadow">

                <img src="images/best-outside-spiker.jpg"
                     class="card-img-top">

                <div class="card-body">
                    <h5>Best Outside Spiker</h5>

                    <p>
                        I received the Best Outside
                        Spiker award in volleyball
                        on April 20, 2024.
                    </p>
                </div>

            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow">

                <img src="images/best-point-guard.jpg"
                     class="card-img-top">

                <div class="card-body">
                    <h5>Best Point Guard</h5>

                    <p>
                        I received the Best Point Guard
                        award in basketball on
                        March 15, 2024.
                    </p>
                </div>

            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow">

                <img src="images/champions.jpg"
                     class="card-img-top">

                <div class="card-body">
                    <h5>Team Champion</h5>

                    <p>
                        We also became champions
                        that year.
                    </p>
                </div>

            </div>
        </div>

    </div>
</section>

<!-- CONTACT -->
<section id="contact" class="container py-5">

    <h2 class="text-center mb-4">
        Contact Me
    </h2>

    <div class="row">

        <div class="col-md-6">

            <form id="contactForm">

                <input type="text"
                       id="name"
                       class="form-control mb-3"
                       placeholder="Your Name"
                       required>

                <input type="email"
                       id="email"
                       class="form-control mb-3"
                       placeholder="Your Email"
                       required>

                <textarea id="message"
                          class="form-control mb-3"
                          placeholder="Your Message"
                          rows="4"
                          required></textarea>

                <button type="submit"
                        class="btn btn-dark w-100">
                    SEND
                </button>

                <p id="formNotice" class="mt-3"></p>

            </form>

        </div>

        <div class="col-md-6">

            <h5>Contact Information</h5>

            <p>☎ Phone: 09XX-XXX-XXXX</p>

            <p>✉ Email: yourname@gmail.com</p>

            <p>f Facebook: Your Facebook Name</p>

        </div>

    </div>
</section>

<!-- FOOTER -->
<footer class="text-center bg-dark text-white p-3">
    <p>© 2026 Billy Joe Laguer | My Portfolio</p>
</footer>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<!-- Custom JS -->
<script src="script.js"></script>

</body>
</html>
